# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública do site (usada nos links de compartilhamento e no manifest)
NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app

# Chave da API lida pelo Lyra e, se for o caso, pelo Tom Louvores.
# Header: Authorization: Bearer <este valor>. Não use o prefixo NEXT_PUBLIC.
# Gere um valor longo e aleatório e configure o mesmo valor no outro app.
LYRA_API_KEY=
